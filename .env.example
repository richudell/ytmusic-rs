# Required: Google OAuth client (create in Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=your-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Register this exact redirect URI on the OAuth client in Google Cloud
# Console: http://127.0.0.1:8765/oauth/callback (port must match below)
OAUTH_REDIRECT_PORT=8765

# Required: 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
# There is no insecure fallback if this is missing — the server refuses to start.
ENCRYPTION_KEY=

# Optional: where the encrypted OAuth token is stored
# Default: ~/.config/ytmusic-rs/tokens.enc
TOKEN_STORAGE_PATH=
